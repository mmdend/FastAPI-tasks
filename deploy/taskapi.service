[Unit]
Description=Task Manager API (Gunicorn with Uvicorn workers)
After=network.target postgresql.service

[Service]
User=taskapi
Group=taskapi
WorkingDirectory=/opt/task-manager
ExecStart=/opt/task-manager/venv/bin/gunicorn app.main:app \
    --worker-class uvicorn_worker.UvicornWorker \
    --workers 3 \
    --bind 127.0.0.1:8000
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target